# =============================================================================
# Green Chillyz Catering — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT — Next.js
# Only NEXT_PUBLIC_ variables are exposed to the browser.
# Do NOT prefix database URLs, secrets, or service keys with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Base URL of the NestJS API (accessible from the Next.js server/browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Application environment
NEXT_PUBLIC_APP_ENV=development

# WhatsApp click-to-chat number (E.164 digits, no leading +), used to build
# wa.me links across the site (FAB, header, footer, post-enquiry handoff).
#
# CONFIRMED by the client in their Website Information Form (2026-09-25) as the
# business WhatsApp Business number, and confirmed to also be the primary
# phone number. It is the default in client/src/config/site.ts; set this only to
# override it.
#
# ⚠️ A wa.me link only OPENS WhatsApp for the customer to send. It is NOT a
# server-side notification to the business. See the integrations block below.
NEXT_PUBLIC_WHATSAPP_NUMBER=919090022220

# -----------------------------------------------------------------------------
# SERVER — NestJS
# These variables are ONLY read server-side. Never expose to the browser.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE — Prisma + Supabase PostgreSQL
#
# DATABASE_URL     : Used by Prisma for migrations and queries.
#                    For Supabase, use the connection-pooling URL (port 6543)
#                    with ?pgbouncer=true when deploying with a serverless/edge
#                    runtime. For a traditional NestJS server process, the
#                    direct URL (port 5432) is also valid.
#
# DIRECT_URL       : Used by Prisma for migrations ONLY (bypasses pgbouncer).
#                    Required when DATABASE_URL uses pgbouncer.
#                    Set to the direct Supabase connection string (port 5432).
#
# See: https://www.prisma.io/docs/guides/database/supabase
# -----------------------------------------------------------------------------

# Prisma primary connection (pooled via pgbouncer for deployed envs)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:6543/postgres?pgbouncer=true

# Prisma migration connection (direct — bypasses pgbouncer)
DIRECT_URL=postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# API rate limiting — requests per minute per IP
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# INTEGRATIONS — CONFIRMED CLIENT REQUIREMENT, NOT YET IMPLEMENTED
# -----------------------------------------------------------------------------
# The client confirmed that after a form submission they want:
#     Save Enquiry  +  WhatsApp notification  +  Email notification
# with notifications delivered to WhatsApp AND email, and also visible in the
# website / admin panel.
#
# The enquiry save already works (POST /api/v1/enquiries -> PostgreSQL).
# The two notification channels DO NOT exist yet:
#   * WhatsApp  — requires an approved WhatsApp Business Platform account and
#                 a Cloud API token. The client has confirmed WhatsApp Business
#                 is enabled on the number, but has not supplied a WABA ID,
#                 phone number ID or access token.
#   * Email     — requires an SMTP provider and credentials. No mailer is
#                 installed and no credentials exist.
#   * Admin panel — not built; the enquiries are only queryable via SQL/API.
#
# These values are intentionally left commented out. Nothing in the codebase
# reads them yet. Do not add a notification module that logs or simulates
# delivery without real, working credentials — see docs/src/06-enquiry-system.md
# and docs/src/11-scope-and-conflicts.md.
#
# Recipient email confirmed by the client (also their public contact address):
# NOTIFICATION_EMAIL=greenchillyzcatering@gmail.com

# WhatsApp Business Cloud API — client approval + credentials required
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email / SMTP — provider + credentials required
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Google Analytics (Phase 3+)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
